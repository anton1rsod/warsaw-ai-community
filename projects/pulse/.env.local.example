# Pulse — local env for LIVE runs (P2 §10.2 verification).
# 1. Copy this file to `.env.local`  (cp .env.local.example .env.local)
# 2. Fill each value from your Notion setup (SETUP.md). DO NOT commit `.env.local` — it's gitignored.
# 3. Run, e.g.:  pnpm exec tsx --env-file=.env.local scripts/sync-notion.ts
#
# Tokens: Notion → Settings → Connections → your two integrations (SETUP.md §3).
# Ids:    the 32-char id in each database/page URL (SETUP.md §5).

# --- pulse-mirror integration (Read + Insert + Update) → 4 context DBs + Digests page ---
NOTION_TOKEN=
NOTION_DB_PROJECTS=
NOTION_DB_DECISIONS=
NOTION_DB_SHIPPING=
NOTION_DB_ENGAGEMENT=
NOTION_DIGEST_PAGE=

# --- pulse-export integration (Read ONLY) → Tasks DB ---
NOTION_READ_TOKEN=
NOTION_DB_TASKS=

# --- optional: makes Decision rows link to GitHub blobs (else links are bare repo paths) ---
GITHUB_REPO_URL=https://github.com/anton1rsod/warsaw-ai-community
